# =============================================================================
# SSE endpoint configuration for system_updater process scripts
# =============================================================================
# Process scripts use Server-Sent Events (SSE) for real-time progress updates.
# Standard web server settings can buffer, compress, or kill these long-lived
# connections. This file ensures they work correctly on Plesk/Apache/FastCGI.

# Prevent mod_deflate from buffering SSE output.
# text/event-stream is not in the default DEFLATE filter list, but some
# Plesk configurations enable compression for all text/* responses.
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI "process_.*\.php$" no-gzip dont-vary
    # download_backup.php is not SSE but it streams a binary body via
    # readfile(); disabling compression guarantees the SHA-256 of the
    # response body matches the SHA-256 of the source file.
    SetEnvIfNoCase Request_URI "download_backup\.php$" no-gzip dont-vary
</IfModule>

# Disable mod_security (OWASP CRS) for the plugin directory.
# SSE streams with long query strings and continuous output trigger false positives.
#
# IMPORTANT: SecRuleEngine is only valid in server/vhost/directory/.htaccess
# context, NOT inside <FilesMatch> (File context). Wrapping it in <FilesMatch>
# makes Apache reject the whole .htaccess with
#   "SecRuleEngine not allowed in <FilesMatch> context"
# and return HTTP 500 for every request under this directory. Directory level is
# the finest granularity .htaccess offers, so the engine is disabled for the
# whole plugin folder (all of its endpoints are admin-only).
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>
<IfModule security2_module>
    SecRuleEngine Off
</IfModule>

# Override root .htaccess caching headers for SSE process scripts.
# Root .htaccess sets Cache-Control: no-store, no-cache, must-revalidate, max-age=0
# for ALL .php files.  SSE needs "no-cache" specifically — "no-store" causes some
# reverse proxies (nginx, Cloudflare) to reject the stream, and "no-transform"
# prevents intermediary re-encoding.
<IfModule mod_headers.c>
    <FilesMatch "^(process_backup|process_core_update|process_restore|recovery)\.php$">
        Header set Cache-Control "no-cache, no-transform"
        Header set X-Accel-Buffering "no"
        Header set Connection "keep-alive"
    </FilesMatch>
    # download_backup.php serves authenticated binary content.  We override
    # the root no-store default with a slightly tighter no-store + nosniff
    # pair so the browser cannot guess a different content type for the
    # attachment (defence in depth: the PHP code already emits the right
    # Content-Type and Cache-Control).
    <FilesMatch "^download_backup\.php$">
        Header set Cache-Control "no-store"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>