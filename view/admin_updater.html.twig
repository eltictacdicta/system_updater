{#
/**
 * This file is part of system_updater plugin for FSFramework
 * Vista del Actualizador del Sistema
 */
#}
{{ include('header.html.twig') }}
{{ fsc.csrf_meta_html|raw }}
{{ fsc.su_csrf_meta_html|raw }}

<div class="container-fluid" style="margin-top: 10px;">
    <div class="row">
        <div class="col-xs-6">
            <div class="btn-group">
                <a class="btn btn-sm btn-default" href="{{ fsc.url()|raw }}" title="Recargar la página">
                    <span class="glyphicon glyphicon-refresh"></span>
                </a>
                <a class="btn btn-sm btn-info" href="index.php?page=admin_plugin_store&tab=public" title="Abrir plugins públicos">
                    <i class="fa fa-globe"></i>
                    <span class="hidden-xs">&nbsp;Plugins públicos</span>
                </a>
                <a class="btn btn-sm btn-warning" href="index.php?page=admin_plugin_store&tab=private" title="Abrir plugins privados">
                    <i class="fa fa-lock"></i>
                    <span class="hidden-xs">&nbsp;Plugins privados</span>
                </a>
            </div>
        </div>
        <div class="col-xs-6 text-right">
            <h2 style="margin-top: 0px;">
                <i class="fa fa-sync-alt"></i> Actualizador del Sistema
            </h2>
        </div>
    </div>
</div>

{# Mensajes #}
{% if fsc.successMessage %}
<div class="alert alert-success alert-dismissible" style="margin: 10px;">
    <button type="button" class="close" data-dismiss="alert">&times;</button>
    <i class="fa fa-check-circle"></i> {{ fsc.successMessage }}
</div>
{% endif %}

{% if fsc.errorMessage %}
<div class="alert alert-danger alert-dismissible" style="margin: 10px;">
    <button type="button" class="close" data-dismiss="alert">&times;</button>
    <i class="fa fa-exclamation-circle"></i> {{ fsc.errorMessage }}
</div>
{% endif %}

{% if fsc.maintenanceStatus and fsc.maintenanceStatus.available %}
<div class="row" style="margin: 10px;">
    <div class="col-md-12">
        <div class="panel panel-{% if fsc.maintenanceStatus and fsc.maintenanceStatus.active %}warning{% else %}default{% endif %}">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-wrench"></i> Modo mantenimiento</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-8">
                        {% if fsc.maintenanceStatus and fsc.maintenanceStatus.active %}
                        <form method="post" action="{{ fsc.url()|raw }}">
                            <input type="hidden" name="action" value="disable_maintenance">
                            {{ fsc.csrf_field_html|raw }}
                            <button type="submit" class="btn btn-default" {% if fsc.maintenanceStatus.forced %}disabled title="Desactiva primero FS_FORCE_MAINTENANCE en config.php"{% else %}data-confirm-message="¿Desactivar el modo mantenimiento?"{% endif %}>
                                <i class="fa fa-play"></i> Desactivar mantenimiento
                            </button>
                        </form>
                        {% else %}
                        {% set stealthReady = fsc.maintenanceStatus and fsc.maintenanceStatus.stealth and fsc.maintenanceStatus.stealth.ready %}
                        <form method="post" action="{{ fsc.url()|raw }}">
                            <input type="hidden" name="action" value="enable_maintenance">
                            {{ fsc.csrf_field_html|raw }}
                            {% if not stealthReady %}
                            <div class="alert alert-warning">
                                <i class="fa fa-eye-slash"></i>
                                El modo stealth no está configurado. Durante el mantenimiento podrías perder la ruta de acceso del administrador si no lo activas antes.
                                <a href="index.php?page=admin_stealth" class="btn btn-xs btn-warning" style="margin-left: 10px;">
                                    <i class="fa fa-cog"></i> Configurar stealth
                                </a>
                            </div>
                            {% endif %}
                            <div class="form-group">
                                <label for="maintenance_message">Mensaje visible</label>
                                <input type="text" class="form-control" id="maintenance_message" name="maintenance_message" value="{{ (fsc.maintenanceStatus ? fsc.maintenanceStatus.message : '')|e('html_attr') }}" placeholder="Mantenimiento programado en curso.">
                            </div>
                            <div class="form-group">
                                <label for="retry_after">Retry-After (segundos)</label>
                                <input type="number" min="60" step="60" class="form-control" id="retry_after" name="retry_after" value="{{ fsc.maintenanceStatus and fsc.maintenanceStatus.state ? fsc.maintenanceStatus.state.retry_after|default(300) : 300 }}">
                            </div>
                            <button type="submit" class="btn btn-warning btn-enable-maintenance" {% if fsc.maintenanceStatus and fsc.maintenanceStatus.forced %}disabled title="Desactiva primero FS_FORCE_MAINTENANCE en config.php"{% endif %}>
                                <i class="fa fa-power-off"></i> Activar mantenimiento
                            </button>
                        </form>
                        {% endif %}
                    </div>
                    <div class="col-md-4">
                        <div class="well well-sm" style="margin-bottom: 0;">
                            <strong>Uso recomendado</strong>
                            <p class="small" style="margin: 8px 0 0;">Actívalo antes de cambios manuales en BD o tareas delicadas. Las actualizaciones críticas desde este panel ya lo activan automáticamente.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}

<div class="row" style="margin: 10px;">
    {# Panel de Actualizaciones #}
    <div class="col-md-6">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-download"></i> Actualizaciones Disponibles</h3>
            </div>
            <div class="panel-body" id="updates-panel-body">
                {% if fsc.updates.updater_pending %}
                <div class="alert alert-warning">
                    <strong><i class="fa fa-clock"></i> Hay una actualización del actualizador pendiente de aplicar</strong>
                    <p>Versión preparada: {{ fsc.updates.updater_pending.new_version }}</p>
                    <a href="{{ fsc.updates.updater_pending.finalize_url }}" class="btn btn-warning btn-sm">
                        <i class="fa fa-play"></i> Finalizar Actualización
                    </a>
                </div>
                {% endif %}

                <p class="text-muted" style="margin-bottom: 12px;">
                    Núcleo local: <strong>v{{ fsc.plugin_manager.version }}</strong>
                    · Actualizador: <strong>v{{ fsc.updaterInfo.version }}</strong>
                </p>

                <p style="margin-bottom: 12px;">
                    <button type="button" class="btn btn-primary btn-sm" id="btn-check-updates">
                        <i class="fa fa-search"></i> Comprobar actualizaciones
                    </button>
                    <button type="button" class="btn btn-default btn-sm" id="btn-resync-schema" title="Re-ejecuta la creación de tablas de los plugins instalados sin descargarlos. Útil cuando un plugin instaló su código pero sus tablas nunca se crearon.">
                        <i class="fa fa-database"></i> Re-sincronizar esquema
                    </button>
                    <span id="updates-check-spinner" style="display: none; margin-left: 10px;">
                        <i class="fa fa-spinner fa-spin"></i> Consultando repositorios remotos…
                    </span>
                </p>

                <div id="updates-check-results">
                    <p class="text-muted">
                        <i class="fa fa-info-circle"></i>
                        Pulsa «Comprobar actualizaciones» para consultar el núcleo, el actualizador y los plugins instalados.
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# Panel de Backups #}
    <div class="col-md-6">
        <div class="panel panel-success">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-database"></i> Copias de Seguridad</h3>
            </div>
            <div class="panel-body">
                <p>
                    <button type="button" class="btn btn-success" id="btn-create-backup">
                        <i class="fa fa-plus"></i> Crear Backup Completo
                    </button>
                    <button type="button" class="btn btn-info" id="btn-show-upload" data-toggle="collapse" data-target="#uploadBackupPanel">
                        <i class="fa fa-cloud-upload"></i> Subir Backup
                    </button>
                    <span id="backup-loading" style="display:none; margin-left: 10px;">
                        <i class="fa fa-spinner fa-spin"></i> Procesando...
                    </span>
                </p>

                {# Panel de subida colapsable #}
                <div class="collapse" id="uploadBackupPanel">
                    <div class="panel panel-info" style="margin-top: 10px;">
                        <div class="panel-heading">
                            <h4 class="panel-title"><i class="fa fa-cloud-upload"></i> Subir Copia de Seguridad</h4>
                        </div>
                        <div class="panel-body">
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"></i>
                                <strong>Subida por fragmentos:</strong> Permite subir archivos ZIP de hasta 2GB.
                                Si la conexión se interrumpe, la subida se puede reanudar.
                            </div>
                            
                            {# Zona de Drop #}
                            <div id="backup-drop-zone" style="border: 2px dashed #3c8dbc; border-radius: 8px; padding: 40px; text-align: center; cursor: pointer; background: #f8f9fa; transition: all 0.3s;">
                                <i class="fa fa-cloud-upload" style="font-size: 48px; color: #3c8dbc;"></i>
                                <h4>Arrastra el archivo ZIP aquí</h4>
                                <p class="text-muted">o haz clic para seleccionar</p>
                                <button type="button" class="btn btn-primary" id="backup-browse-btn">
                                    <i class="fa fa-folder-open"></i> Seleccionar Archivo
                                </button>
                            </div>
                            
                            {# Progreso de subida #}
                            <div id="backup-upload-progress" style="display: none; margin-top: 15px;">
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar progress-bar-info progress-bar-striped active" role="progressbar" 
                                         style="width: 0%; line-height: 25px;" id="backup-progress-bar">
                                        <span id="backup-progress-text">0%</span>
                                    </div>
                                </div>
                                <p id="backup-upload-status" class="text-center text-muted" style="margin-top: 10px;"></p>
                            </div>
                            
                            <div style="margin-top: 15px;">
                                <ul class="list-inline text-muted">
                                    <li><i class="fa fa-check text-success"></i> Formato: <strong>.zip</strong></li>
                                    <li><i class="fa fa-check text-success"></i> Tamaño máximo: <strong>2 GB</strong></li>
                                    <li><i class="fa fa-check text-success"></i> Subida reanudable</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="backups-container">
                    {% if fsc.backups|length > 0 %}
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for group in fsc.backups %}
                            <tr>
                                <td>
                                    <strong>{{ group.base_name }}</strong>
                                    <br><small class="text-muted">
                                        {% if group.complete %}
                                            <span class="label label-primary" title="{{ group.complete.size_formatted }}">Completo ({{ group.complete.size_formatted }})</span>
                                        {% endif %}
                                        {% if group.files %}
                                            <span class="label label-info" title="{{ group.files.size_formatted }}">Archivos ({{ group.files.size_formatted }})</span>
                                        {% endif %}
                                        {% if group.database %}
                                            <span class="label label-warning" title="{{ group.database.size_formatted }}">BD ({{ group.database.size_formatted }})</span>
                                        {% endif %}
                                    </small>
                                </td>
                                <td>{{ group.date|date('d/m/Y H:i') }}</td>
                                <td>
                                    <div class="btn-group btn-group-xs">
                                        {% if group.complete %}
                                        <div class="btn-group btn-group-xs">
                                            <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">
                                                <i class="fa fa-download"></i> <span class="caret"></span>
                                            </button>
                                            <ul class="dropdown-menu pull-right">
                                                <li><a href="plugins/system_updater/download_backup.php?file={{ group.complete.name|e('url') }}&su_csrf_token={{ fsc.su_csrf_token|e('url') }}" target="_blank">Descargar Completo</a></li>
                                                {% if group.files %}<li><a href="plugins/system_updater/download_backup.php?file={{ group.files.name|e('url') }}&su_csrf_token={{ fsc.su_csrf_token|e('url') }}" target="_blank">Descargar Archivos</a></li>{% endif %}
                                                {% if group.database %}<li><a href="plugins/system_updater/download_backup.php?file={{ group.database.name|e('url') }}&su_csrf_token={{ fsc.su_csrf_token|e('url') }}" target="_blank">Descargar BD</a></li>{% endif %}
                                            </ul>
                                        </div>
                                        <button type="button" class="btn btn-warning btn-restore" data-action="restore_complete" data-file="{{ group.complete.name }}" title="Restaurar todo">
                                            <i class="fa fa-undo"></i>
                                        </button>
                                        {% if group.can_restore_database and group.database_restore_file %}
                                        <button type="button" class="btn btn-default btn-restore" data-action="restore_database" data-file="{{ group.database_restore_file }}" title="Restaurar solo base de datos">
                                            <i class="fa fa-database"></i>
                                        </button>
                                        {% endif %}
                                        {% endif %}
                                        
                                        {% if not group.complete %}
                                            {% if group.files %}
                                            <a href="plugins/system_updater/download_backup.php?file={{ group.files.name|e('url') }}&su_csrf_token={{ fsc.su_csrf_token|e('url') }}" class="btn btn-default" title="Descargar Archivos" target="_blank">
                                                <i class="fa fa-download"></i>
                                            </a>
                                            <button type="button" class="btn btn-default btn-restore" data-action="restore_files" data-file="{{ group.files.name }}" title="Restaurar Archivos">
                                                <i class="fa fa-folder"></i>
                                            </button>
                                            {% endif %}
                                            {% if group.database %}
                                            <a href="plugins/system_updater/download_backup.php?file={{ group.database.name|e('url') }}&su_csrf_token={{ fsc.su_csrf_token|e('url') }}" class="btn btn-default" title="Descargar BD" target="_blank">
                                                <i class="fa fa-database"></i>
                                            </a>
                                            <button type="button" class="btn btn-default btn-restore" data-action="restore_database" data-file="{{ group.database.name }}" title="Restaurar BD">
                                                <i class="fa fa-database"></i>
                                            </button>
                                            {% endif %}
                                        {% endif %}

                                        <button type="button" class="btn btn-danger btn-delete" data-base="{{ group.base_name }}" title="Eliminar">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% else %}
                    <p class="text-muted">No hay copias de seguridad.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script{{ fsc.script_nonce_attr|raw }} type="text/javascript">
$(document).ready(function() {
    var csrfToken = $('meta[name="csrf-token"]').attr('content') || '';
    var suCsrfToken = $('meta[name="su-csrf-token"]').attr('content') || '';
    var restoreLog = [];
    var restoreFinished = false;
    var restoreConsecutiveFailures = 0;
    var restoreStepCount = 0;
    var restoreLastFile = '';
    var restoreLastType = '';
    var backupLastStatusMessage = '';
    var backupLog = [];
    var backupFinished = false;
    var backupFinalizing = false;
    var backupPollTimer = null;
    var coreUpdateEventSource = null;
    var coreUpdateLog = [];
    var coreUpdateFinished = false;
    var pendingCoreAction = null;
    var pendingChainedPluginUpdates = [];
    var lastUpdatesSnapshot = null;
    var pendingBackupChain = null;
    var pendingRiskyOperation = null;
    var targetCoreVersion = '{{ fsc.plugin_manager.version|e('js') }}';
    var updaterBaseUrl = '{{ fsc.url()|raw }}';
    var updatesCheckInProgress = false;
    var warningsCheckInProgress = false;
    var coreActionsLocked = false;
    var stealthReady = {{ (fsc.maintenanceStatus and fsc.maintenanceStatus.stealth and fsc.maintenanceStatus.stealth.ready) ? 'true' : 'false' }};

    function escapeHtml(text) {
        return $('<div>').text(text == null ? '' : String(text)).html();
    }

    function escapeAttr(text) {
        return escapeHtml(text).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function safeUrl(url) {
        var value = String(url == null ? '' : url);
        if (/^(https?:)?\/\//i.test(value) || /^[a-z0-9_.\-/?=&%]+$/i.test(value)) {
            return value.replace(/"/g, '%22');
        }
        return '';
    }

    function renderUpdatesPanel(updates, meta) {
        var html = '';
        var updaterVersion = meta && meta.updater_version ? meta.updater_version : '';
        var coreVersion = meta && meta.core_version ? meta.core_version : '';

        if (updates.updater && updates.updater.available) {
            html += '<div class="alert alert-danger">';
            html += '<strong><i class="fa fa-wrench"></i> Nueva versión del actualizador disponible</strong>';
            html += '<p>Versión actual: ' + escapeHtml(updaterVersion) + '<br>';
            html += 'Nueva versión: ' + escapeHtml(updates.updater.new_version || '') + '</p>';
            html += '<p class="small" style="margin-bottom: 10px;">';
            html += 'La actualización se preparará primero y el reemplazo final se realizará desde el cargador externo para evitar sobrescribir el plugin mientras se está ejecutando.';
            html += '</p>';
            html += '<a href="' + updaterBaseUrl + '&action=prepare_updater_update" class="btn btn-danger btn-sm" data-confirm-message="¿Preparar y aplicar la actualización del plugin system_updater? El intercambio final se hará desde updater.php para mantener la estabilidad.">';
            html += '<i class="fa fa-sync"></i> Actualizar Actualizador</a></div>';
        } else if (!updates.updater_pending) {
            html += '<div class="alert alert-success"><i class="fa fa-check"></i> El plugin actualizador está actualizado (v' + escapeHtml(updaterVersion) + ')</div>';
        }

        if (updates.core) {
            html += '<div class="alert alert-warning">';
            html += '<strong><i class="fa fa-cube"></i> Nueva versión del núcleo disponible</strong>';
            html += '<p>Versión actual: ' + escapeHtml(coreVersion) + '<br>';
            html += 'Nueva versión: ' + escapeHtml(updates.core_new_version || '') + '</p>';
            if (updates.has_chained_update_plan && updates.chained_plugin_updates && updates.chained_plugin_updates.length) {
                html += '<p class="small">Hay ' + updates.chained_plugin_updates.length + ' plugin(s) cuya actualización remota requiere primero el núcleo '
                    + escapeHtml(updates.core_new_version || '') + '.</p>';
                html += '<button type="button" class="btn btn-primary btn-sm" id="btn-chained-core-plugins-update" style="margin-right: 8px;">';
                html += '<i class="fa fa-link"></i> Actualizar núcleo y ' + updates.chained_plugin_updates.length + ' plugin(s)</button>';
            }
            html += '<button type="button" class="btn btn-warning btn-sm" id="btn-update-core">';
            html += '<i class="fa fa-sync"></i> Actualizar solo núcleo</button></div>';
        } else {
            html += '<div class="alert alert-success clearfix">';
            html += '<i class="fa fa-check"></i> El núcleo está actualizado (v' + escapeHtml(coreVersion) + ')';
            html += '<button type="button" class="btn btn-danger btn-xs pull-right" id="btn-reinstall-core" style="margin-top: -2px;">';
            html += '<i class="fa fa-exclamation-triangle"></i> Reinstalar Core</button></div>';
        }

        var plugins = updates.plugins || [];
        var publicUpdates = updates.ready_plugin_updates || updates.public_plugin_updates || [];
        var readyPublicCount = publicUpdates.filter(function(plugin) {
            return (plugin.update_status || 'ready') === 'ready';
        }).length;

        if (plugins.length > 0) {
            html += '<h5><i class="fa fa-puzzle-piece"></i> Plugins con actualizaciones:</h5>';
            if (readyPublicCount > 0) {
                html += '<form method="post" action="' + updaterBaseUrl + '" style="margin-bottom: 10px;">';
                html += '<input type="hidden" name="action" value="update_all_public_plugins">';
                if (csrfToken) {
                    html += '<input type="hidden" name="_csrf_token" value="' + escapeAttr(csrfToken) + '">';
                }
                html += '<button type="submit" class="btn btn-sm btn-primary" data-confirm-message="¿Actualizar todos los plugins públicos compatibles con el núcleo actual?">';
                html += '<i class="fa fa-sync"></i> Actualizar compatibles ahora (' + readyPublicCount + ')</button></form>';
            }
            html += '<table class="table table-sm table-striped"><thead><tr>';
            html += '<th>Plugin</th><th>Origen</th><th>Actual</th><th>Nueva</th><th>Estado</th><th></th>';
            html += '</tr></thead><tbody>';
            plugins.forEach(function(plugin) {
                var sourceLabel = plugin.source === 'public'
                    ? '<span class="label label-success">público</span>'
                    : '<span class="label label-warning">privado</span>';
                var status = plugin.update_status || 'ready';
                var statusHtml = '';
                var actionHtml = '';

                if (status === 'blocked_by_core') {
                    statusHtml = '<span class="label label-warning">Tras actualizar núcleo</span>';
                    if (plugin.required_core_version) {
                        statusHtml += '<br><small class="text-muted">Requiere FSFramework '
                            + escapeHtml(plugin.required_core_version) + '+</small>';
                    }
                    actionHtml = '<span class="text-muted"><i class="fa fa-lock"></i> Pendiente de núcleo</span>';
                } else if (status === 'incompatible') {
                    statusHtml = '<span class="label label-danger">Incompatible</span>';
                    actionHtml = '<span class="text-danger">' + escapeHtml(plugin.message || 'No compatible') + '</span>';
                } else {
                    statusHtml = '<span class="label label-success">Listo</span>';
                    actionHtml = '<a href="' + updaterBaseUrl + '&action=update_plugin&plugin=' + encodeURIComponent(plugin.name)
                        + '" class="btn btn-xs btn-primary" data-confirm-message="¿Actualizar ' + escapeAttr(plugin.name) + '?">'
                        + '<i class="fa fa-sync"></i> Actualizar</a>';
                }

                html += '<tr>';
                html += '<td>' + escapeHtml(plugin.name) + '</td>';
                html += '<td>' + sourceLabel + '</td>';
                html += '<td>' + escapeHtml(plugin.current_version) + '</td>';
                html += '<td><span class="label label-info">' + escapeHtml(plugin.new_version) + '</span></td>';
                html += '<td>' + statusHtml + '</td>';
                html += '<td>' + actionHtml + '</td></tr>';
            });
            html += '</tbody></table>';
        } else {
            html += '<p class="text-muted"><i class="fa fa-check"></i> Todos los plugins están actualizados.</p>';
        }

        $('#updates-check-results').html(html);

        if (coreActionsLocked) {
            $('#btn-update-core, #btn-reinstall-core').prop('disabled', true);
        }

        if (updates.core && updates.core_new_version) {
            targetCoreVersion = updates.core_new_version;
        } else {
            targetCoreVersion = coreVersion;
        }

        lastUpdatesSnapshot = updates;
    }

    function openChainedCorePluginWizard() {
        if (!lastUpdatesSnapshot || !lastUpdatesSnapshot.chained_plugin_updates
            || !lastUpdatesSnapshot.chained_plugin_updates.length) {
            return;
        }

        pendingChainedPluginUpdates = lastUpdatesSnapshot.chained_plugin_updates.map(function(plugin) {
            return plugin.name;
        });

        openCoreActionWizard(false);
    }

    function updateChainedPlugins(pluginNames) {
        if (!pluginNames || !pluginNames.length) {
            return;
        }

        $('#updates-check-results').prepend(
            '<div class="alert alert-info" id="chained-plugins-progress">'
            + '<i class="fa fa-spinner fa-spin"></i> Actualizando plugins tras la actualización del núcleo…'
            + '</div>'
        );

        $.ajax({
            url: updaterBaseUrl + '&action=update_chained_plugins&ajax=1',
            type: 'POST',
            dataType: 'json',
            data: {
                _csrf_token: csrfToken,
                plugins: pluginNames
            },
            timeout: 300000,
            success: function(response) {
                $('#chained-plugins-progress').remove();

                if (response && response.success) {
                    var message = response.message || 'Plugins actualizados correctamente.';
                    if (response.failed && response.failed.length) {
                        message += ' No se pudieron actualizar: ' + response.failed.join(', ') + '.';
                    }
                    $('#updates-check-results').prepend(
