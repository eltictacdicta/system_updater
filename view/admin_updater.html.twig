                    onConfirm();
                }
                return;
            }

            pendingRiskyOperation = onConfirm;
            $('#operationWarningTitle').text(title);
            $('#operationWarningMessage').text(message);
            $('#operationWarningList').html(renderOperationWarnings(warnings));
            $('#operationWarningModal').modal('show');
        }, extraParams || null);
    }

