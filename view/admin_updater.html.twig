    function fetchOperationWarnings(callback, extraParams) {
        var url = '{{ fsc.url()|raw }}&action=operation_warnings&ajax=1&_csrf_token=' + encodeURIComponent(csrfToken);
        if (extraParams) {
            $.each(extraParams, function(key, value) {
                if (value !== undefined && value !== null && value !== '') {
                    url += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(value);
                }
            });
        }
        $.ajax({
            url: url,
            type: 'GET',
            dataType: 'json',
            timeout: 15000,
            success: function(response) {
                callback((response && response.warnings) ? response.warnings : []);
            },
            error: function() {
                callback([{
                    level: 'warning',
                    message: 'No se pudieron comprobar las advertencias operativas. Continúa solo si estás seguro.'
                }]);
            }
        });
    }

    function renderOperationWarnings(warnings) {
        if (!warnings || !warnings.length) {
            return '';
        }

        return warnings.map(function(warning) {
            var html = '<div class="alert alert-' + (warning.level === 'warning' ? 'warning' : 'info') + '" style="margin-bottom: 10px;">';
            html += '<i class="fa fa-exclamation-triangle"></i> ' + $('<div>').text(warning.message || '').html();
            var linkHref = warning.link ? safeUrl(warning.link) : '';
            if (linkHref && warning.link_label) {
                html += ' <a href="' + linkHref + '" class="btn btn-xs btn-default" style="margin-left: 8px;">' + $('<div>').text(warning.link_label).html() + '</a>';
            }
            if (warning.users && warning.users.length) {
                html += '<ul style="margin: 8px 0 0 18px;">';
                warning.users.forEach(function(user) {
                    var detail = user.nick;
                    if (user.last_login) {
                        detail += ' (' + user.last_login + ')';
                    }
                    html += '<li>' + $('<div>').text(detail).html() + '</li>';
                });
                html += '</ul>';
            }
            html += '</div>';
            return html;
        }).join('');
    }

    function confirmRiskyOperation(title, message, onConfirm, extraParams) {
        if (warningsCheckInProgress) {
