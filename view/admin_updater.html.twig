    // Restaurar por pasos: un `begin` + N x `chunk`. Cada request queda corto y
    // reanudable, porque el host puede matar el proceso a los pocos segundos y
    // un stream SSE único no sobrevive a eso.
    function startRestore(file, type) {
        restoreLog = [];
        restoreFinished = false;
        restoreConsecutiveFailures = 0;
        restoreStepCount = 0;
        restoreLastFile = file;
        restoreLastType = type;
        updateProgress(0, 'Iniciando restauración...');
        $('#restoreDetails').html('<small class="text-muted">Conectando al servidor...</small>');
        $('#restoreCompleteBtn').hide();
        $('#restoreErrorBtn').hide();

        // Show modal
        $('#restoreProgressModal').modal('show');

        runRestoreStep('begin');
    }

    function runRestoreStep(action) {
        if (restoreFinished) {
            return;
        }

        restoreStepCount++;
        if (restoreStepCount > 100000) {
            finishRestoreAsError('La restauración no termina de avanzar. Se detuvo por seguridad.');
            return;
        }

        var url = 'plugins/system_updater/process_restore.php?action=' + action
            + '&file=' + encodeURIComponent(restoreLastFile)
            + '&type=' + encodeURIComponent(restoreLastType)
            + '&su_csrf_token=' + encodeURIComponent(suCsrfToken);

        fetch(url, {
            credentials: 'same-origin',
            cache: 'no-store',
            headers: { 'Accept': 'text/event-stream' }
        }).then(function(response) {
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }
            return response.text();
        }).then(function(body) {
            var events = parseRestoreSseEvents(body);
            var sawProgress = false;
            var doneData = null;
            var errorData = null;
            var busy = false;

            for (var i = 0; i < events.length; i++) {
                var evt = events[i];

                if (evt.event === 'progress') {
                    sawProgress = true;

                    if (evt.data.step === 'busy') {
                        busy = true;
                        continue;
                    }

                    updateProgress(evt.data.percent || 0, evt.data.message);
                    addLogEntry(evt.data.message);

                    if (evt.data.done) {
                        doneData = evt.data;
                    }
                } else if (evt.event === 'error') {
                    errorData = evt.data;
                }
            }

            // Otro proceso tiene el lock del estado: no es un fallo, es esperar.
            if (busy && !doneData && !errorData) {
                window.setTimeout(function() {
                    runRestoreStep('chunk');
                }, 2000);
                return;
            }

            if (errorData) {
                logRestoreDetail(errorData);
                finishRestoreAsError(
                    errorData.message || 'La restauración falló.',
                    errorData.percent || 0
                );
                return;
            }

            if (doneData) {
                // Terminar con errores SQL no es un éxito aunque el proceso haya acabado.
                if ((doneData.errors_count || 0) > 0) {
                    logRestoreDetail(doneData);
                    finishRestoreAsError(doneData.message, 100);
                    return;
                }
                if ((doneData.warnings_count || 0) > 0) {
                    logRestoreDetail(doneData);
                }
                finishRestoreAsSuccess(doneData.warnings_count || 0);
                return;
            }

            if (!sawProgress) {
                throw new Error('respuesta sin progreso');
            }

            restoreConsecutiveFailures = 0;
            runRestoreStep('chunk');
        }).catch(function(error) {
            if (restoreFinished) {
                return;
            }

            restoreConsecutiveFailures++;

            // Un corte no pierde trabajo: el checkpoint queda en disco, así que
            // se reintenta y se reanuda desde el último punto guardado.
            if (restoreConsecutiveFailures <= 5) {
                addLogEntry('↻ Corte o error de red (' + error.message + '). Reintentando desde el último punto guardado...');
                window.setTimeout(function() {
                    runRestoreStep('chunk');
                }, 1500);
                return;
            }

            finishRestoreAsError(
                'No se pudo continuar tras varios intentos (' + error.message + '). El avance queda guardado en el '
                + 'servidor, pero volver a iniciar la restauración la reinicia desde el principio. Si el sitio quedó '
                + 'en mantenimiento, se libera solo al usar el panel.'
            );
        });
    }

    // El servidor responde con framing SSE (los guards de sesión/CSRF dependen
    // del script por URI), así que se parsea el cuerpo completo del request.
    function parseRestoreSseEvents(body) {
        var events = [];
        var blocks = String(body).split(/\r?\n\r?\n/);

        for (var i = 0; i < blocks.length; i++) {
            var lines = blocks[i].split(/\r?\n/);
            var name = '';
            var data = '';

            for (var j = 0; j < lines.length; j++) {
                if (lines[j].indexOf('event:') === 0) {
                    name = lines[j].substring(6).trim();
                } else if (lines[j].indexOf('data:') === 0) {
                    data += lines[j].substring(5).trim();
                }
            }

            if (!name || !data) {
                continue;
            }

            try {
                events.push({ event: name, data: JSON.parse(data) });
            } catch (err) {
                // Bloque no parseable: se ignora y se sigue con el resto.
            }
        }

        return events;
    }

    // Vuelca el detalle de errores y avisos al panel. Un contador sin los
    // mensajes no le sirve al operador para saber qué falló.
    function logRestoreDetail(payload) {
        var errors = payload.errors || [];
        var warnings = payload.warnings || [];

        for (var i = 0; i < errors.length; i++) {
            addLogEntry('   ✗ ' + errors[i]);
        }

        for (var j = 0; j < warnings.length; j++) {
            addLogEntry('   ⚠ ' + warnings[j]);
        }
    }

    function finishRestoreAsSuccess(warningCount) {
        restoreFinished = true;

        var message = '¡Restauración completada con éxito!';
        if (warningCount > 0) {
            message += ' (' + warningCount + ' aviso(s) en el registro)';
        }

        updateProgress(100, message, 'success');
        addLogEntry('✓ ' + message);
        $('#restoreCompleteBtn').show();
    }

    function finishRestoreAsError(message, percent) {
        restoreFinished = true;
        updateProgress(percent || 0, message, 'danger');
        addLogEntry('✗ ERROR: ' + message);
        $('#restoreErrorBtn').show();
    }
    
    function updateProgress(percent, message, type) {
        var $progressBar = $('#restoreProgressBar');
        var $statusMessage = $('#restoreStatusMessage');
        var $statusText = $('#restoreStatusText');
        
        $progressBar.css('width', percent + '%');
        $progressBar.attr('aria-valuenow', percent);
        $progressBar.text(Math.round(percent) + '%');
        
        $statusText.text(message);
        
        // Update alert type
        $statusMessage.removeClass('alert-info alert-success alert-danger');
        if (type === 'success') {
            $statusMessage.addClass('alert-success');
            $progressBar.removeClass('active progress-bar-striped');
        } else if (type === 'danger') {
            $statusMessage.addClass('alert-danger');
            $progressBar.addClass('progress-bar-danger');
        } else {
            $statusMessage.addClass('alert-info');
        }
    }
    
    function addLogEntry(message) {
        restoreLog.push('[' + new Date().toLocaleTimeString() + '] ' + message);
        var $detailsDiv = $('#restoreDetails');
        $detailsDiv.html(restoreLog.map(function(entry) {
            return '<div>' + entry + '</div>';
        }).join(''));
        $detailsDiv.scrollTop($detailsDiv[0].scrollHeight);
    }

    // Restaurar - usando botones con data attributes
    $('.btn-restore').click(function(e) {
        e.preventDefault();
        var action = $(this).data('action');
        var file = $(this).data('file');
        var msg = '¿Está seguro de querer restaurar esta copia?';
        var type = 'complete';
        
        if(action == 'restore_complete') {
            msg = '¿Restaurar sistema COMPLETO? Esto sobrescribirá archivos y base de datos.';
            type = 'complete';
        } else if(action == 'restore_files') {
            msg = '¿Restaurar solo los ARCHIVOS?';
            type = 'files';
        } else if(action == 'restore_database') {
            msg = '¿Restaurar solo la BASE DE DATOS?';
            type = 'database';
        }
        
        confirmRiskyOperation(
            'Confirmar restauración',
            msg,
            function() {
                startRestore(file, type);
            }
        );
    });

    // Eliminar
    $('.btn-delete').click(function(e) {
        e.preventDefault();
        var baseName = $(this).data('base');
        
        if(confirm('¿Eliminar este grupo de copias de seguridad?')) {
            showLoading();
            $.ajax({
                url: '{{ fsc.url()|raw }}&action=delete_backup_group&base_name=' + encodeURIComponent(baseName) + '&ajax=1',
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    if(response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                        hideLoading();
                    }
                },
                error: function() {
                    alert('Error de conexión');
                    hideLoading();
                }
            });
        }
    });

    $('.btn-enable-maintenance').closest('form').on('submit', function(e) {
        var form = this;
        e.preventDefault();
        var maintenanceMessage = stealthReady
            ? '¿Activar el modo mantenimiento ahora?'
            : 'El modo stealth no está configurado. Podrías perder la ruta de acceso del administrador. ¿Activar el modo mantenimiento ahora?';
        confirmRiskyOperation(
            'Activar modo mantenimiento',
            maintenanceMessage,
            function() {
                form.submit();
            }
        );
    });

    // Confirmation dialog for elements with data-confirm-message
    $(document).on('click', '[data-confirm-message]', function(e) {
        var message = $(this).data('confirm-message');
        if (message && !window.confirm(message)) {
            e.preventDefault();
            e.stopPropagation();
        }
    });
});
</script>

<!-- Resumable.js para subida por chunks -->
<script{{ fsc.script_nonce_attr|raw }} type="text/javascript" src="https://cdn.jsdelivr.net/npm/resumablejs@1.1.0/resumable.min.js"></script>

<script{{ fsc.script_nonce_attr|raw }} type="text/javascript">
$(document).ready(function() {
    // ========================================
    // BACKUP UPLOAD FUNCTIONALITY
    // ========================================
    
    // Verificar que Resumable esté disponible
    if (typeof Resumable === 'undefined') {
        console.error('Resumable.js no está cargado');
        $('#backup-upload-status').html('<span class="text-danger"><i class="fa fa-exclamation-triangle"></i> Error: Resumable.js no está disponible</span>');
        return;
    }
    
    var $dropZone = $('#backup-drop-zone');
    var $browseButton = $('#backup-browse-btn');
    var $progressContainer = $('#backup-upload-progress');
    var $progressBar = $('#backup-progress-bar');
    var $progressText = $('#backup-progress-text');
    var $statusText = $('#backup-upload-status');
    
    if ($dropZone.length === 0) return;

    var uploadCsrfToken = $('meta[name="csrf-token"]').attr('content') || '';
    
    // Configurar Resumable.js
    var r = new Resumable({
        target: '{{ fsc.url()|raw }}',
        chunkSize: 10 * 1024 * 1024, // 10MB por chunk
        simultaneousUploads: 3,
        testChunks: false,
        throttleProgressCallbacks: 0.5,
        fileType: ['zip'],
        maxFiles: 1,
        maxFileSize: 2 * 1024 * 1024 * 1024, // 2GB máximo
        query: uploadCsrfToken ? {
            _csrf_token: uploadCsrfToken
        } : {},
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRF-TOKEN': uploadCsrfToken
        }
    });
    
    if (!r.support) {
        alert('Tu navegador no soporta subidas de archivos grandes. Por favor, actualiza tu navegador.');
        return;
    }
    
    // Asignar el drag & drop
    r.assignDrop($dropZone[0]);
    r.assignBrowse($browseButton[0]);
    
    // Efectos visuales de drag & drop
    $dropZone.on('dragover', function(e) {
        e.preventDefault();
        $(this).css({
            'border-color': '#00a65a',
            'background': '#e8f5e9'
        });
    });
    
    $dropZone.on('dragleave drop', function(e) {
        $(this).css({
            'border-color': '#3c8dbc',
            'background': '#f8f9fa'
        });
    });
    
    // Click en la zona para abrir selector
    $dropZone.on('click', function(e) {
        if (!$(e.target).is('button')) {
            $browseButton.click();
        }
    });
    
    // Evento: Archivo añadido
    r.on('fileAdded', function(file) {
        // Validar extensión
        var ext = file.fileName.split('.').pop().toLowerCase();
        if (ext !== 'zip') {
            alert('Solo se permiten archivos .zip de backup');
            return false;
        }
        
        // Mostrar barra de progreso
        $progressContainer.show();
        $dropZone.hide();
        $progressBar.css('width', '0%').removeClass('progress-bar-success progress-bar-danger').addClass('progress-bar-info active');
        $progressText.text('0%');
        $statusText.text('Preparando subida de: ' + file.fileName);
        
        // Iniciar la subida
        r.upload();
    });
    
    // Evento: Progreso de subida
    r.on('fileProgress', function(file) {
        var progress = Math.floor(file.progress() * 100);
        $progressBar.css('width', progress + '%');
        $progressText.text(progress + '%');
        
        if (progress < 100) {
            var fileSize = formatBytes(file.size);
            var uploaded = formatBytes(file.size * file.progress());
            $statusText.text('Subiendo: ' + file.fileName + ' (' + uploaded + ' de ' + fileSize + ')');
        }
    });
    
    // Evento: Subida exitosa
    r.on('fileSuccess', function(file, message) {
        $progressBar.removeClass('active progress-bar-info').addClass('progress-bar-success');
        $progressText.text('100%');
        $statusText.html('<span class="text-success"><i class="fa fa-check-circle"></i> ¡Archivo subido correctamente!</span>');
        
        // Recargar la página después de 2 segundos
        setTimeout(function() {
            window.location.reload();
        }, 2000);
    });
    
    // Evento: Error en la subida
    r.on('fileError', function(file, message) {
        $progressBar.removeClass('active progress-bar-info').addClass('progress-bar-danger');
        
        var errorMsg = 'Error desconocido';
        try {
            var response = JSON.parse(message);
            errorMsg = response.message || message;
        } catch(e) {
            errorMsg = message;
        }
        
        $statusText.html('<span class="text-danger"><i class="fa fa-exclamation-triangle"></i> <strong>Error:</strong> ' + errorMsg + '</span>');
        
        // Mostrar opción de reintentar
        setTimeout(function() {
            if (confirm('¿Deseas reintentar la subida?')) {
                r.upload();
            } else {
                // Restaurar zona de drop
                $progressContainer.hide();
                $dropZone.show();
                r.files = [];
            }
        }, 2000);
    });
    
    // Función para formatear bytes
    function formatBytes(bytes) {
        if (bytes >= 1073741824) {
            return (bytes / 1073741824).toFixed(2) + ' GB';
        } else if (bytes >= 1048576) {
            return (bytes / 1048576).toFixed(2) + ' MB';
        } else if (bytes >= 1024) {
            return (bytes / 1024).toFixed(2) + ' KB';
        } else {
            return bytes + ' bytes';
        }
    }
});
</script>

